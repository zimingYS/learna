#!/bin/sh
# commit-msg：校验 Conventional Commits（type 白名单同 CONTRIBUTING §2.2）
# 临时跳过：LEARNA_SKIP_HOOKS=1 git commit ...
[ "${LEARNA_SKIP_HOOKS:-0}" = "1" ] && exit 0

MSG_FILE="$1"
FIRST=$(head -1 "$MSG_FILE")

# 放行合并/回退/fixup 提交
case "$FIRST" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s' "$FIRST" | grep -qE '^(feat|fix|docs|chore|refactor|test|build|ci)(\([a-zA-Z0-9_/-]+\))?!?: .+'; then
  echo "commit-msg: 提交信息不符合 Conventional Commits 规范" >&2
  echo "  期望: type(scope): subject（type 白名单: feat fix docs chore refactor test build ci）" >&2
  echo "  实际: $FIRST" >&2
  exit 1
fi
