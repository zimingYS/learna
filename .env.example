# 复制为 .env 后按需修改
# 真实 .env 不得提交（根 .gitignore 已忽略 .env）。

### 应用 ###
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
RUST_LOG=info,backend=debug

### 数据库 ###
DATABASE_URL=postgres://learna:devpass@localhost:5432/learna
DATABASE_MAX_CONNECTIONS=10

### AI服务 ###
AI_SERVICE_BASE_URL=http://localhost:8001
# 内部服务凭据，留空=未配置；真实值生成：openssl rand -hex 32
AI_SERVICE_TOKEN=

### 密钥加密 ###
ENCRYPTION_MASTER_KEY=

### 存储 ###
STORAGE_PROVIDER=local
STORAGE_ROOT_DIR=./data/uploads

### 认证 ###
JWT_SECRET=

### 部署（docker compose --env-file .env） ###
# POSTGRES_PASSWORD 与 JWT_SECRET 生产必填，compose 不设默认值
POSTGRES_USER=learna
POSTGRES_PASSWORD=
POSTGRES_DB=learna
# 宿主机端口映射：数据库 5433、前端 80（可按需修改避免冲突）
POSTGRES_HOST_PORT=5433
HTTP_PORT=80
